environments:
  default:
    values:
    - environments/default.yaml
  cluster:
    values:
    - environments/cluster.yaml.gotmpl
    - values/env-values-nuxeo-third-party.yaml.gotmpl
  third-party-auth:
    values:
    - environments/third-party-auth.yaml.gotmpl
    - values/env-values-nuxeo-third-party.yaml.gotmpl
---
repositories:
- name: opensearch
  url: https://opensearch-project.github.io/helm-charts/

helmDefaults:
  timeout: 300
  wait: true

releases:
- name: nuxeo
  chart: ./../../nuxeo
  {{ if ne .Environment.Name "default" }}
  needs:
  - versitygw
  - mongodb
  - opensearch
  - kafka
  {{ end }}
  values:
  - values/values-nuxeo.yaml.gotmpl
# versitygw-init provisions the PVC and pre-creates the S3 bucket directory
# before VersityGW starts. The upstream versitygw chart reuses the PVC it
# creates (persistence.create=false) so the bucket is guaranteed to exist
# when VersityGW accepts its first request from Nuxeo.
- name: versitygw-init
  chart: ./versitygw-init
  condition: deployment.versitygw.enabled
  values:
  - values/values-versitygw-init.yaml.gotmpl
- name: versitygw
  chart: oci://ghcr.io/versity/versitygw/charts/versitygw
  version: "0.3.5"
  condition: deployment.versitygw.enabled
  needs:
  - versitygw-init
  values:
  - values/values-versitygw.yaml.gotmpl
- name: mongodb
  chart: oci://registry-1.docker.io/bitnamicharts/mongodb
  version: 13.3.1
  condition: deployment.mongodb.enabled
  values:
  - values/values-mongodb.yaml.gotmpl
- name: opensearch
  chart: opensearch/opensearch
  version: 1.16.0
  condition: deployment.opensearch.enabled
  values:
  - values/values-opensearch.yaml.gotmpl
- name: kafka
  chart: oci://registry-1.docker.io/bitnamicharts/kafka
  version: 26.4.3
  condition: deployment.kafka.enabled
  values:
  - values/values-kafka.yaml.gotmpl
