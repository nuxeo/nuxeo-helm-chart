{{- $localDomain := printf "%s.svc.cluster.local" ( requiredEnv "NAMESPACE" ) -}}
packages: amazon-s3-online-storage
customEnvs:
- name: NUXEO_CLID
  valueFrom:
    secretKeyRef:
      name: instance-clid
      key: instance.clid
amazonS3:
  enabled: true
  auth:
    # Must stay in sync with auth.accessKey/auth.secretKey in values-versitygw.yaml.gotmpl.
    accessKeyId: versitygw
    secretKey: versitygw-secret-key
  # unused but a warn log is produced if not present
  region: us-east-1
  bucket: nuxeo-binary-store
mongodb:
  enabled: true
  host: {{ printf "mongodb.%s" $localDomain }}
elasticsearch:
  enabled: true
  host: {{ printf "opensearch-cluster-master.%s" $localDomain }}
kafka:
  enabled: true
  host: {{ printf "kafka.%s" $localDomain }}
customProperties:
  versitygw: |
    nuxeo.s3storage.endpoint=http://{{ printf "versitygw.%s" $localDomain }}:7070
    nuxeo.s3storage.pathstyleaccess=true
