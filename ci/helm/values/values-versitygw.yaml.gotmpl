## VersityGW base values — upstream chart schema (oci://ghcr.io/versity/versitygw/charts/versitygw)

# Root S3 credentials. Only reachable from inside the cluster — not a
# production secret. Must stay in sync with auth.accessKeyId/secretKey
# in values-nuxeo-third-party.yaml.gotmpl.
auth:
  accessKey: versitygw
  secretKey: versitygw-secret-key

gateway:
  backend:
    type: posix
    # /mnt/data is the PVC mount path used by the upstream chart.
    args: /mnt/data
  port: 7070

image:
  tag: "v1.7.0"

persistence:
  # The PVC is managed by the versitygw-init release so that the bucket
  # directory is guaranteed to exist before VersityGW starts.
  create: false
  claimName: versitygw-data

# Recreate strategy avoids rollout deadlocks with ReadWriteOnce volumes.
strategy:
  type: Recreate

{{ readFile "values-tolerations-nodeselector.yaml" }}
